    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt finds your computer on this Wi-Fi to keep your meetings in sync. Nothing goes through the internet."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجد Yogurt الكمبيوتر على شبكة Wi-Fi هذه لمزامنة اجتماعاتك. لا شيء يمر عبر الإنترنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার মিটিং সিঙ্ক রাখতে Yogurt এই Wi-Fi-তে আপনার কম্পিউটার খোঁজে। কিছুই ইন্টারনেট দিয়ে যায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt hledá váš počítač na této Wi-Fi, aby synchronizoval schůzky. Nic nejde přes internet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt finder din computer på dette wi-fi for at holde dine møder synkroniseret. Intet går via internettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt findet deinen Computer in diesem WLAN, um deine Meetings abzugleichen. Nichts geht über das Internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Yogurt βρίσκει τον υπολογιστή σας σε αυτό το Wi-Fi για να συγχρονίζει τις συσκέψεις σας. Τίποτα δεν περνά από το διαδίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt busca tu ordenador en esta Wi-Fi para mantener tus reuniones sincronizadas. Nada pasa por internet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt etsii tietokoneesi tästä Wi-Fi-verkosta pitääkseen kokoukset synkronoituina. Mitään ei kulje internetin kautta."
