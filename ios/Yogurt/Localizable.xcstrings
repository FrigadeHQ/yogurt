    "Your recording is kept, but it couldn't be saved as a meeting yet. Open Yogurt again to finish." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recording is kept, but it couldn't be saved as a meeting yet. Open Yogurt again to finish."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيلك محفوظ، لكن تعذّر حفظه كاجتماع حتى الآن. افتح Yogurt مرة أخرى لإكمال ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার রেকর্ডিং রাখা আছে, কিন্তু এখনও মিটিং হিসেবে সেভ করা যায়নি। শেষ করতে আবার Yogurt খুলুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávka je v bezpečí, ale zatím ji nešlo uložit jako schůzku. Otevřete Yogurt znovu a dokončete to."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din optagelse er gemt, men den kunne ikke gemmes som et møde endnu. Åbn Yogurt igen for at gøre det færdigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahme ist sicher, konnte aber noch nicht als Meeting gespeichert werden. Öffne Yogurt erneut, um es abzuschließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ηχογράφησή σας διατηρείται, αλλά δεν αποθηκεύτηκε ακόμη ως σύσκεψη. Ανοίξτε ξανά το Yogurt για να ολοκληρωθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu grabación está a salvo, pero aún no se pudo guardar como reunión. Vuelve a abrir Yogurt para terminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenne on tallessa, mutta sitä ei voitu vielä tallentaa kokouksena. Avaa Yogurt uudelleen viimeistelläksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakatabi ang recording mo, pero hindi pa ito na-save bilang meeting. Buksan ulit ang Yogurt para matapos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre enregistrement est conservé, mais il n’a pas encore pu être enregistré comme réunion. Rouvrez Yogurt pour terminer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההקלטה שמורה, אבל עדיין לא ניתן היה לשמור אותה כפגישה. יש לפתוח את Yogurt שוב כדי לסיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रिकॉर्डिंग सुरक्षित है, लेकिन अभी मीटिंग के रूप में सेव नहीं हो सकी। पूरा करने के लिए Yogurt फिर से खोलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felvételed megvan, de még nem sikerült megbeszélésként menteni. Nyisd meg újra a Yogurtot a befejezéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman Anda tetap ada, tetapi belum bisa disimpan sebagai rapat. Buka Yogurt lagi untuk menyelesaikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione è al sicuro, ma non è ancora stato possibile salvarla come riunione. Riapri Yogurt per finire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音は残っていますが、まだミーティングとして保存できていません。Yogurtをもう一度開くと完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음은 남아 있지만 아직 회의로 저장하지 못했어요. Yogurt를 다시 열면 마무리돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakaman anda disimpan, tetapi belum dapat disimpan sebagai mesyuarat. Buka Yogurt semula untuk selesaikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptaket ditt er tatt vare på, men kunne ikke lagres som et møte ennå. Åpne Yogurt igjen for å fullføre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opname is bewaard, maar kon nog niet als meeting worden opgeslagen. Open Yogurt opnieuw om het af te ronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagranie jest bezpieczne, ale nie udało się jeszcze zapisać go jako spotkania. Otwórz Yogurt ponownie, aby dokończyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua gravação está guardada, mas ainda não pôde ser salva como reunião. Abra o Yogurt de novo para terminar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrarea e păstrată, dar nu a putut fi salvată încă drept întâlnire. Deschideți din nou Yogurt ca să terminați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись сохранена, но пока не стала встречей. Откройте Yogurt ещё раз, чтобы закончить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din inspelning finns kvar, men den kunde inte sparas som ett möte än. Öppna Yogurt igen för att slutföra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงที่อัดยังอยู่ แต่ยังบันทึกเป็นการประชุมไม่ได้ เปิด Yogurt อีกครั้งเพื่อทำให้เสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydınız duruyor ama henüz toplantı olarak kaydedilemedi. Bitirmek için Yogurt’u yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис збережено, але він ще не став зустріччю. Відкрийте Yogurt ще раз, щоб завершити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi của bạn vẫn còn, nhưng chưa lưu được thành cuộc họp. Hãy mở lại Yogurt để hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的录音已保留，但还没能保存为会议。再次打开 Yogurt 即可完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的錄音已保留，但還無法儲存為會議。再次打開 Yogurt 即可完成。"
          }
        }
      }
