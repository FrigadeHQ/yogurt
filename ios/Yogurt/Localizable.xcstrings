    "Connect them to see your computer's meetings here, and send what you record on your iPhone back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect them to see your computer's meetings here, and send what you record on your iPhone back."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربطهما لترى اجتماعات الكمبيوتر هنا، وترسل إليه ما تسجّله على الـiPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুটি যুক্ত করুন, যাতে কম্পিউটারের মিটিং এখানে দেখতে পান আর iPhone-এ যা রেকর্ড করেন তা ফেরত পাঠাতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propojte je a uvidíte tady schůzky z počítače a pošlete do něj to, co nahrajete na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbind dem for at se din computers møder her og sende det, du optager på din iPhone, tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde beide, um die Meetings deines Computers hier zu sehen und deine iPhone-Aufnahmen zurückzuschicken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε τα για να βλέπετε εδώ τις συσκέψεις του υπολογιστή και να στέλνετε πίσω ό,τι ηχογραφείτε στο iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctalos para ver aquí las reuniones de tu ordenador y enviarle lo que grabes en tu iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä ne, niin näet tietokoneen kokoukset täällä ja voit lähettää iPhonella tallentamasi takaisin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikonekta ang dalawa para makita rito ang mga meeting sa computer mo, at maibalik doon ang nire-record mo sa iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-les pour voir ici les réunions de votre ordinateur et y renvoyer ce que vous enregistrez sur votre iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לחבר אותם כדי לראות כאן את הפגישות מהמחשב, ולשלוח אליו את מה שמוקלט ב-iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों को जोड़ें ताकि कंप्यूटर की मीटिंग यहाँ दिखें, और iPhone पर रिकॉर्ड की गई चीज़ें वापस जाएँ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold össze őket, hogy itt lásd a számítógéped megbeszéléseit, és visszaküldd, amit az iPhone-on veszel fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan keduanya untuk melihat rapat dari komputer di sini, dan mengirim balik rekaman dari iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegali per vedere qui le riunioni del tuo computer e rimandargli quello che registri sull’iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続すると、コンピュータのミーティングをここで見られ、iPhoneで録音したものを送り返せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하면 컴퓨터의 회의를 여기서 보고, iPhone에서 녹음한 것을 컴퓨터로 보낼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan untuk melihat mesyuarat komputer anda di sini, dan hantar semula apa yang anda rakam pada iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble dem sammen for å se datamaskinens møter her og sende det du tar opp på iPhonen tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel ze om de meetings van je computer hier te zien en wat je op je iPhone opneemt terug te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz je, aby widzieć tu spotkania z komputera i wysyłać do niego nagrania z iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte os dois para ver aqui as reuniões do computador e enviar de volta o que você gravar no iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați-le ca să vedeți aici întâlnirile de pe computer și să trimiteți înapoi ce înregistrați pe iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите их, чтобы видеть здесь встречи с компьютера и отправлять туда записи с iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppla ihop dem för att se datorns möten här och skicka tillbaka det du spelar in på din iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อเพื่อดูการประชุมจากคอมพิวเตอร์ที่นี่ และส่งสิ่งที่อัดบน iPhone กลับไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızdaki toplantıları burada görmek ve iPhone’da kaydettiklerinizi geri göndermek için bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під’єднайте їх, щоб бачити тут зустрічі з комп’ютера і надсилати туди записи з iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối để xem các cuộc họp trên máy tính ở đây, và gửi lại những gì bạn ghi trên iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接后可以在这里看到电脑上的会议，并把 iPhone 上的录音发回电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接後就能在這裡看到電腦上的會議，並把 iPhone 上的錄音傳回電腦。"
          }
        }
      }
    },
    "Connect to see your computer's meetings here too. Everything still works without it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to see your computer's meetings here too. Everything still works without it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل لترى اجتماعات الكمبيوتر هنا أيضًا. كل شيء يعمل من دونه."
          }
        },
        "bn" : {
          "stringUnit" : {
