        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte para ver aqui também as reuniões do seu computador. Tudo funciona sem isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați-vă ca să vedeți aici și întâlnirile de pe computer. Totul funcționează și fără."
