    "Notifications are off, so if a call pauses the recording, you'll see it only when you open Yogurt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off, so if a call pauses the recording, you'll see it only when you open Yogurt."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات متوقفة، لذا إذا أوقفت مكالمة التسجيل مؤقتًا فلن ترى ذلك إلا عند فتح Yogurt."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোটিফিকেশন বন্ধ, তাই কোনো কল রেকর্ডিং থামালে আপনি তা শুধু Yogurt খুললেই দেখবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou vypnutá, takže když hovor pozastaví nahrávání, uvidíte to až po otevření Yogurtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra, så hvis et opkald sætter optagelsen på pause, ser du det først, når du åbner Yogurt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind aus. Wenn ein Anruf die Aufnahme pausiert, siehst du das erst, wenn du Yogurt öffnest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις είναι απενεργοποιημένες, οπότε αν μια κλήση διακόψει την ηχογράφηση, θα το δείτε μόνο όταν ανοίξετε το Yogurt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas, así que si una llamada pausa la grabación, solo lo verás al abrir Yogurt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset ovat pois päältä, joten jos puhelu keskeyttää tallennuksen, näet sen vasta avatessasi Yogurtin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang notifications, kaya kung ma-pause ng tawag ang recording, makikita mo lang ito pagbukas mo ng Yogurt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées : si un appel met l’enregistrement en pause, vous ne le verrez qu’en ouvrant Yogurt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתראות כבויות, כך שאם שיחה משהה את ההקלטה, זה יופיע רק כשתפתחו את Yogurt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफ़िकेशन बंद हैं, इसलिए अगर कोई कॉल रिकॉर्डिंग रोक दे, तो आपको यह Yogurt खोलने पर ही दिखेगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értesítések ki vannak kapcsolva, így ha egy hívás szünetelteti a felvételt, csak a Yogurt megnyitásakor látod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi mati, jadi jika panggilan menjeda rekaman, Anda baru melihatnya saat membuka Yogurt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate: se una chiamata mette in pausa la registrazione, lo vedrai solo quando apri Yogurt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がオフなので、通話で録音が一時停止しても、Yogurtを開くまでわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림이 꺼져 있어서, 통화 때문에 녹음이 일시 정지되면 Yogurt를 열어야만 알 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan dimatikan, jadi jika panggilan menjeda rakaman, anda hanya akan nampak apabila membuka Yogurt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varslinger er slått av, så hvis en samtale setter opptaket på pause, ser du det først når du åpner Yogurt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit, dus als een gesprek de opname pauzeert, zie je dat pas als je Yogurt opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia są wyłączone, więc jeśli połączenie wstrzyma nagrywanie, zobaczysz to dopiero po otwarciu Yogurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas, então se uma ligação pausar a gravação, você só verá ao abrir o Yogurt."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificările sunt dezactivate, așa că dacă un apel pune înregistrarea pe pauză, veți vedea asta doar când deschideți Yogurt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления выключены, поэтому если звонок поставит запись на паузу, вы увидите это, только открыв Yogurt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda, så om ett samtal pausar inspelningen ser du det först när du öppnar Yogurt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนปิดอยู่ ถ้าสายเรียกเข้าทำให้การอัดหยุด คุณจะเห็นก็ต่อเมื่อเปิด Yogurt"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler kapalı; bir arama kaydı duraklatırsa bunu ancak Yogurt’u açtığınızda görürsünüz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення вимкнено, тож якщо дзвінок поставить запис на паузу, ви побачите це лише відкривши Yogurt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đang tắt, nên nếu cuộc gọi làm tạm dừng ghi âm, bạn chỉ thấy khi mở Yogurt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已关闭，所以如果来电暂停了录音，你只有打开 Yogurt 时才会看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已關閉，所以如果來電暫停了錄音，你只有打開 Yogurt 時才會看到。"
          }
        }
      }
    },
