            "state" : "translated",
            "value" : "اجتماعاتك من %@ في الطريق. اضغط تسجيل لتدوّن الملاحظات في أي مكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ থেকে আপনার মিটিং আসছে। যেকোনো জায়গায় নোট নিতে রেকর্ড ট্যাপ করুন।"
