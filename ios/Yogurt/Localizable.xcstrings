    "Turn on Speech recognition in Settings to see the transcript. Your recording is still saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Speech recognition in Settings to see the transcript. Your recording is still saved."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل التعرف على الكلام في الإعدادات لترى النص. سيظل تسجيلك محفوظًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্রান্সক্রিপ্ট দেখতে সেটিংসে স্পিচ রিকগনিশন চালু করুন। আপনার রেকর্ডিং তবুও সেভ হবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte v Nastavení Rozpoznávání řeči, abyste viděli přepis. Nahrávka se i tak uloží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Talegenkendelse til i Indstillinger for at se transskriptionen. Din optagelse bliver stadig gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Spracherkennung in den Einstellungen ein, um das Transkript zu sehen. Deine Aufnahme wird trotzdem gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε την Αναγνώριση ομιλίας στις Ρυθμίσεις για να δείτε την απομαγνητοφώνηση. Η ηχογράφησή σας αποθηκεύεται κανονικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el Reconocimiento de voz en Ajustes para ver la transcripción. Tu grabación se guarda igualmente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita Puheentunnistus päälle Asetuksissa nähdäksesi litteroinnin. Tallenne tallentuu silti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-on ang Speech Recognition sa Settings para makita ang transcript. Mase-save pa rin ang recording mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la reconnaissance vocale dans Réglages pour voir la transcription. Votre enregistrement est quand même sauvegardé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל את זיהוי הדיבור בהגדרות כדי לראות את התמלול. ההקלטה עדיין נשמרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांसक्रिप्ट देखने के लिए सेटिंग्ज़ में वाक् पहचान चालू करें। आपकी रिकॉर्डिंग फिर भी सेव होगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a Beszédfelismerést a Beállításokban az átirat megtekintéséhez. A felvételed így is mentődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Pengenalan Ucapan di Pengaturan untuk melihat transkrip. Rekaman Anda tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Riconoscimento vocale in Impostazioni per vedere la trascrizione. La registrazione viene comunque salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしを見るには、「設定」で音声認識をオンにしてください。録音は保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹취록을 보려면 설정에서 음성 인식을 켜 주세요. 녹음은 그대로 저장돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidupkan Pengecaman Pertuturan dalam Seting untuk melihat transkrip. Rakaman anda tetap disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Talegjenkjenning i Innstillinger for å se transkripsjonen. Opptaket lagres likevel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Spraakherkenning aan in Instellingen om het transcript te zien. Je opname wordt wel bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Rozpoznawanie mowy w Ustawieniach, aby widzieć transkrypcję. Nagranie i tak zostanie zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Reconhecimento de Fala em Ajustes para ver a transcrição. Sua gravação continua salva."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați Recunoaștere vorbire în Configurări ca să vedeți transcrierea. Înregistrarea se salvează totuși."
          }
        },
        "ru" : {
