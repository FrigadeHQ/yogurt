    "This is turned off by a Screen Time or device setting, so Yogurt can't ask for it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is turned off by a Screen Time or device setting, so Yogurt can't ask for it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا متوقف بسبب مدة استخدام الجهاز أو أحد إعدادات الجهاز، لذا لا يستطيع Yogurt طلبه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি স্ক্রিন টাইম বা কোনো ডিভাইস সেটিং বন্ধ করে রেখেছে, তাই Yogurt এর অনুমতি চাইতে পারে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle vypnul Čas u obrazovky nebo nastavení zařízení, takže o to Yogurt nemůže požádat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er slået fra af Skærmtid eller en enhedsindstilling, så Yogurt kan ikke bede om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist durch Bildschirmzeit oder eine Geräteeinstellung ausgeschaltet, deshalb kann Yogurt nicht danach fragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι απενεργοποιημένο από τον Χρόνο επί οθόνης ή μια ρύθμιση της συσκευής, οπότε το Yogurt δεν μπορεί να το ζητήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto está desactivado por Tiempo de uso o un ajuste del dispositivo, así que Yogurt no puede pedirlo."
