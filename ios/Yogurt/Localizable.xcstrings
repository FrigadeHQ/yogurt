        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंप्यूटर की मीटिंग यहाँ भी देखने के लिए जोड़ें। इसके बिना भी सब कुछ काम करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakozz, hogy itt is lásd a számítógéped megbeszéléseit. Minden működik nélküle is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan untuk melihat rapat dari komputer di sini juga. Semuanya tetap berjalan tanpa itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegati per vedere qui anche le riunioni del tuo computer. Tutto funziona anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続すると、コンピュータのミーティングもここで見られます。接続しなくてもすべて使えます。"
