        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papunta na ang mga meeting mo mula sa %@. I-tap ang I-record para mag-note kahit saan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réunions de %@ arrivent. Touchez Enregistrer pour prendre des notes partout."
