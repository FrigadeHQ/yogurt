    "Your iPhone talks to your computer only on the same Wi-Fi. Nothing goes through the internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone talks to your computer only on the same Wi-Fi. Nothing goes through the internet."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتواصل الـiPhone مع الكمبيوتر فقط على شبكة Wi-Fi نفسها. لا شيء يمر عبر الإنترنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iPhone শুধু একই Wi-Fi-তে আপনার কম্পিউটারের সঙ্গে কথা বলে। কিছুই ইন্টারনেট দিয়ে যায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš iPhone komunikuje s počítačem jen ve stejné síti Wi-Fi. Nic nejde přes internet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone taler kun med din computer på samme wi-fi. Intet går via internettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone spricht mit deinem Computer nur im selben WLAN. Nichts geht über das Internet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPhone σας μιλά με τον υπολογιστή σας μόνο στο ίδιο Wi-Fi. Τίποτα δεν περνά από το διαδίκτυο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone habla con tu ordenador solo en la misma red Wi-Fi. Nada pasa por internet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonesi puhuu tietokoneesi kanssa vain samassa Wi-Fi-verkossa. Mitään ei kulje internetin kautta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kausap lang ng iPhone mo ang computer mo sa iisang Wi-Fi. Walang dumadaan sa internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone ne communique avec votre ordinateur que sur le même réseau Wi-Fi. Rien ne passe par Internet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-iPhone מדבר עם המחשב רק באותה רשת Wi-Fi. שום דבר לא עובר דרך האינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका iPhone आपके कंप्यूटर से सिर्फ़ एक ही Wi-Fi पर बात करता है। कुछ भी इंटरनेट से नहीं जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone-od csak ugyanazon a Wi-Fi-hálózaton beszél a számítógépeddel. Semmi sem megy át az interneten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Anda hanya berbicara dengan komputer Anda di Wi-Fi yang sama. Tidak ada yang lewat internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo iPhone parla con il tuo computer solo sulla stessa rete Wi-Fi. Niente passa da internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneは同じWi-Fi上でのみコンピュータと通信します。インターネットを経由するものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone은 같은 Wi-Fi에서만 컴퓨터와 통신해요. 인터넷을 거치는 것은 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone anda hanya bercakap dengan komputer anda pada Wi-Fi yang sama. Tiada apa-apa melalui internet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen din snakker bare med datamaskinen din på samme wifi. Ingenting går via internett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iPhone praat alleen via hetzelfde wifi-netwerk met je computer. Er gaat niets via internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój iPhone łączy się z komputerem tylko w tej samej sieci Wi-Fi. Nic nie przechodzi przez internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone fala com seu computador só na mesma rede Wi-Fi. Nada passa pela internet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-ul vorbește cu computerul doar în aceeași rețea Wi-Fi. Nimic nu trece prin internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone связывается с компьютером только в одной сети Wi-Fi. Ничего не идёт через интернет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone pratar bara med din dator på samma wifi. Inget går via internet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone จะคุยกับคอมพิวเตอร์ของคุณผ่าน Wi-Fi เดียวกันเท่านั้น ไม่มีอะไรผ่านอินเทอร์เน็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuz bilgisayarınızla yalnızca aynı Wi-Fi ağında konuşur. Hiçbir şey internetten geçmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone спілкується з комп’ютером лише в тій самій мережі Wi-Fi. Нічого не йде через інтернет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone chỉ trò chuyện với máy tính của bạn trên cùng mạng Wi-Fi. Không có gì đi qua internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 只在同一 Wi-Fi 下与你的电脑通信。任何内容都不经过互联网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 只在同一 Wi-Fi 下與你的電腦通訊。任何內容都不經過網際網路。"
          }
        }
      }
    },
    "Your iPhone will ask to find devices on your network. Tap Allow so Yogurt can reach your computer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone will ask to find devices on your network. Tap Allow so Yogurt can reach your computer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب الـiPhone إذنًا للعثور على الأجهزة في شبكتك. اضغط السماح ليصل Yogurt إلى الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iPhone নেটওয়ার্কে ডিভাইস খোঁজার অনুমতি চাইবে। অনুমতি দিন ট্যাপ করুন, যাতে Yogurt আপনার কম্পিউটারে পৌঁছাতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone se zeptá, jestli smí hledat zařízení ve vaší síti. Klepněte na Povolit, aby se Yogurt dostal k počítači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone vil spørge om lov til at finde enheder på dit netværk. Tryk på Tillad, så Yogurt kan nå din computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone fragt, ob es Geräte in deinem Netzwerk finden darf. Tippe auf Erlauben, damit Yogurt deinen Computer erreicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPhone θα ζητήσει να βρίσκει συσκευές στο δίκτυό σας. Πατήστε Να επιτρέπεται ώστε το Yogurt να φτάσει στον υπολογιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone pedirá permiso para buscar dispositivos en tu red. Toca Permitir para que Yogurt pueda llegar a tu ordenador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonesi kysyy lupaa etsiä laitteita verkostasi. Napauta Salli, jotta Yogurt tavoittaa tietokoneesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hihingi ang iPhone mo ng pahintulot na maghanap ng mga device sa network mo. I-tap ang Payagan para maabot ng Yogurt ang computer mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone va demander à trouver des appareils sur votre réseau. Touchez Autoriser pour que Yogurt puisse joindre votre ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-iPhone יבקש לחפש מכשירים ברשת שלך. יש להקיש על אפשר כדי ש-Yogurt יגיע למחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका iPhone आपके नेटवर्क पर डिवाइस खोजने की अनुमति माँगेगा। अनुमति दें पर टैप करें ताकि Yogurt आपके कंप्यूटर तक पहुँच सके।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone-od engedélyt kér az eszközök kereséséhez a hálózatodon. Koppints az Engedélyezés gombra, hogy a Yogurt elérje a számítógéped."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Anda akan meminta izin mencari perangkat di jaringan Anda. Ketuk Izinkan agar Yogurt bisa menjangkau komputer Anda."
