    "The recording couldn't start. Close other apps using the microphone and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording couldn't start. Close other apps using the microphone and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر بدء التسجيل. أغلق التطبيقات الأخرى التي تستخدم الميكروفون وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রেকর্ডিং শুরু করা গেল না। মাইক্রোফোন ব্যবহার করছে এমন অন্য অ্যাপ বন্ধ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávání se nepodařilo spustit. Zavřete jiné aplikace, které používají mikrofon, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelsen kunne ikke starte. Luk andre apps, der bruger mikrofonen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme konnte nicht starten. Schließ andere Apps, die das Mikrofon nutzen, und versuch es noch mal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ηχογράφηση δεν ξεκίνησε. Κλείστε άλλες εφαρμογές που χρησιμοποιούν το μικρόφωνο και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar la grabación. Cierra otras apps que usen el micrófono e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus ei käynnistynyt. Sulje muut mikrofonia käyttävät apit ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nagsimula ang recording. Isara ang ibang app na gumagamit ng mikropono at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement n’a pas pu démarrer. Fermez les autres apps qui utilisent le micro et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחיל את ההקלטה. יש לסגור אפליקציות אחרות שמשתמשות במיקרופון ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग शुरू नहीं हो सकी। माइक्रोफ़ोन इस्तेमाल कर रहे दूसरे ऐप बंद करें और फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felvétel nem indult el. Zárd be a mikrofont használó többi appot, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman tidak bisa dimulai. Tutup app lain yang memakai mikrofon, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile avviare la registrazione. Chiudi le altre app che usano il microfono e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音を開始できませんでした。マイクを使っているほかのアプリを閉じて、もう一度お試しください。"
