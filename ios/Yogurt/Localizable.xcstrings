    "Yogurt couldn't open its storage on this iPhone. Restart your iPhone and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt couldn't open its storage on this iPhone. Restart your iPhone and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Yogurt فتح مساحة التخزين على هذا الـiPhone. أعد تشغيل الـiPhone وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt এই iPhone-এ তার স্টোরেজ খুলতে পারেনি। iPhone রিস্টার্ট করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt nemohl otevřít své úložiště na tomto iPhonu. Restartujte iPhone a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt kunne ikke åbne sin lagring på denne iPhone. Genstart din iPhone, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yogurt konnte seinen Speicher auf diesem iPhone nicht öffnen. Starte dein iPhone neu und versuch es noch mal."
