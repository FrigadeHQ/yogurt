    "They come over from your computer when both are on the same Wi-Fi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They come over from your computer when both are on the same Wi-Fi."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل من الكمبيوتر عندما يكون الاثنان على شبكة Wi-Fi نفسها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দুটি একই Wi-Fi-তে থাকলে এগুলো আপনার কম্পিউটার থেকে আসে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přicházejí z počítače, když jsou oba na stejné Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kommer fra din computer, når begge er på samme wi-fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie kommen von deinem Computer, wenn beide im selben WLAN sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έρχονται από τον υπολογιστή σας όταν είναι και τα δύο στο ίδιο Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegan desde tu ordenador cuando los dos están en la misma Wi-Fi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne tulevat tietokoneeltasi, kun molemmat ovat samassa Wi-Fi-verkossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galing ang mga ito sa computer mo kapag nasa iisang Wi-Fi ang dalawa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles arrivent de votre ordinateur quand les deux sont sur le même Wi-Fi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הן מגיעות מהמחשב כששניהם באותה רשת Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब दोनों एक ही Wi-Fi पर हों, तो ये आपके कंप्यूटर से आती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számítógépedről érkeznek, amikor ugyanazon a Wi-Fin vannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapat datang dari komputer Anda saat keduanya di Wi-Fi yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrivano dal tuo computer quando sono sulla stessa Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方が同じWi-Fiにあると、コンピュータから届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 같은 Wi-Fi에 있으면 컴퓨터에서 가져와요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia datang dari komputer anda apabila kedua-duanya pada Wi-Fi yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kommer fra datamaskinen når begge er på samme wifi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze komen van je computer als ze op hetzelfde wifi zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przychodzą z komputera, gdy oba są w tej samej sieci Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas chegam do seu computador quando os dois estão na mesma Wi-Fi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vin de pe computer când amândouă sunt în aceeași rețea Wi-Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они приходят с компьютера, когда оба в одной сети Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kommer från din dator när båda är på samma wifi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประชุมจะมาจากคอมพิวเตอร์เมื่อทั้งสองอยู่ใน Wi-Fi เดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisi aynı Wi-Fi’dayken bilgisayarınızdan gelirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони приходять із комп’ютера, коли обидва в одній мережі Wi-Fi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng được gửi từ máy tính khi cả hai cùng Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者在同一 Wi-Fi 下时，会议会从你的电脑传过来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩者在同一個 Wi-Fi 時，會議會從你的電腦傳過來。"
          }
        }
      }
    },
    "This computer doesn't recognise this iPhone any more. Pair again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This computer doesn't recognise this iPhone any more. Pair again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا الكمبيوتر يتعرف على هذا الـiPhone. أقرنهما مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কম্পিউটার আর এই iPhone চিনতে পারছে না। আবার যুক্ত করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento počítač už tento iPhone nepoznává. Spárujte je znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne computer genkender ikke længere denne iPhone. Par dem igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Computer erkennt dieses iPhone nicht mehr. Kopple es erneut."
          }
