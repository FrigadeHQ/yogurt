    "Couldn't reach your computer. Check that both are on the same Wi-Fi and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach your computer. Check that both are on the same Wi-Fi and try again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الكمبيوتر. تأكد من أنهما على شبكة Wi-Fi نفسها وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কম্পিউটারে পৌঁছানো গেল না। দুটি একই Wi-Fi-তে আছে কিনা দেখে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítač se nepodařilo zastihnout. Zkontrolujte, že jsou oba na stejné Wi-Fi, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå din computer. Tjek, at begge er på samme wi-fi, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Computer war nicht erreichbar. Prüf, ob beide im selben WLAN sind, und versuch es noch mal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με τον υπολογιστή σας. Ελέγξτε ότι είναι και τα δύο στο ίδιο Wi-Fi και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con tu ordenador. Comprueba que los dos están en la misma Wi-Fi e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokonetta ei tavoitettu. Tarkista, että molemmat ovat samassa Wi-Fi-verkossa, ja yritä uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maabot ang computer mo. Tiyaking nasa iisang Wi-Fi ang dalawa at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre votre ordinateur. Vérifiez que les deux sont sur le même Wi-Fi et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להגיע למחשב. יש לבדוק ששניהם באותה רשת Wi-Fi ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कंप्यूटर तक नहीं पहुँच सके। जाँचें कि दोनों एक ही Wi-Fi पर हैं और फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült elérni a számítógéped. Ellenőrizd, hogy ugyanazon a Wi-Fin vannak-e, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa menjangkau komputer Anda. Pastikan keduanya di Wi-Fi yang sama, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
