    "Getting %@ ready for transcripts on this iPhone. This happens once; the recording has already started." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting %@ ready for transcripts on this iPhone. This happens once; the recording has already started."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تجهيز %@ للنصوص على هذا الـiPhone. يحدث هذا مرة واحدة فقط، والتسجيل بدأ بالفعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPhone-এ ট্রান্সক্রিপ্টের জন্য %@ প্রস্তুত করা হচ্ছে। এটা একবারই হয়; রেকর্ডিং ইতিমধ্যে শুরু হয়েছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připravuji jazyk %@ pro přepisy na tomto iPhonu. Stane se to jen jednou; nahrávání už běží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør %@ klar til transskriptioner på denne iPhone. Det sker kun én gang; optagelsen er allerede i gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird für Transkripte auf diesem iPhone vorbereitet. Das passiert nur einmal; die Aufnahme läuft schon."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προετοιμάζονται τα %@ για απομαγνητοφώνηση σε αυτό το iPhone. Γίνεται μόνο μία φορά· η ηχογράφηση έχει ήδη ξεκινήσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparando la transcripción en %@ en este iPhone. Solo pasa una vez; la grabación ya empezó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valmistellaan kieltä %@ litterointia varten tällä iPhonella. Tämä tehdään vain kerran; tallennus on jo käynnissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inihahanda ang %@ para sa mga transcript sa iPhone na ito. Isang beses lang ito; nagsimula na ang recording."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparation de la transcription en %@ sur cet iPhone. Cela n’arrive qu’une fois ; l’enregistrement a déjà commencé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכין את %@ לתמלול ב-iPhone הזה. זה קורה פעם אחת בלבד; ההקלטה כבר התחילה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर ट्रांसक्रिप्ट के लिए %@ तैयार की जा रही है। यह सिर्फ़ एक बार होता है; रिकॉर्डिंग शुरू हो चुकी है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
