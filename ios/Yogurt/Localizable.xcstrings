    "Too many wrong codes. Type the new code your computer shows." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many wrong codes. Type the new code your computer shows."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز خاطئة كثيرة. اكتب الرمز الجديد الذي يعرضه الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনেকবার ভুল কোড। আপনার কম্পিউটারে দেখানো নতুন কোড লিখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příliš mnoho špatných kódů. Zadejte nový kód, který ukazuje počítač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange forkerte koder. Skriv den nye kode, som din computer viser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele falsche Codes. Gib den neuen Code ein, den dein Computer zeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρα πολλοί λάθος κωδικοί. Πληκτρολογήστε τον νέο κωδικό που δείχνει ο υπολογιστής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados códigos incorrectos. Escribe el nuevo código que muestra tu ordenador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian monta väärää koodia. Kirjoita tietokoneesi näyttämä uusi koodi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrang daming maling code. I-type ang bagong code na ipinapakita ng computer mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de codes erronés. Saisissez le nouveau code affiché par votre ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יותר מדי קודים שגויים. יש להקליד את הקוד החדש שהמחשב מציג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत सारे गलत कोड। आपका कंप्यूटर जो नया कोड दिखा रहा है, वह लिखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túl sok hibás kód. Írd be az új kódot, amelyet a számítógéped mutat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak kode salah. Ketik kode baru yang ditampilkan komputer Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi codici sbagliati. Inserisci il nuovo codice che mostra il tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違ったコードが多すぎます。コンピュータに表示された新しいコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "틀린 코드가 너무 많아요. 컴퓨터에 표시된 새 코드를 입력해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak kod salah. Taip kod baharu yang ditunjukkan komputer anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For mange feil koder. Skriv inn den nye koden datamaskinen viser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel verkeerde codes. Typ de nieuwe code die je computer toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za dużo błędnych kodów. Wpisz nowy kod pokazany przez komputer."
