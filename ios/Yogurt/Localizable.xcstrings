        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone vai pedir para encontrar dispositivos na sua rede. Toque em Permitir para que o Yogurt alcance seu computador."
          }
        },
        "ro" : {
          "stringUnit" : {
