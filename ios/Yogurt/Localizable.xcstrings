        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפגישות שלך מ-%@ בדרך. יש להקיש על הקלטה כדי לרשום הערות בכל מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से आपकी मीटिंग आ रही हैं। कहीं भी नोट्स लेने के लिए रिकॉर्ड करें पर टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megbeszéléseid úton vannak innen: %@. Koppints a Felvétel gombra, és jegyzetelj bárhol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapat Anda dari %@ sedang dalam perjalanan. Ketuk Rekam untuk mencatat di mana saja."
