          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakaman tidak dapat dimulakan. Tutup app lain yang menggunakan mikrofon dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptaket kunne ikke starte. Lukk andre apper som bruker mikrofonen, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname kon niet starten. Sluit andere apps die de microfoon gebruiken en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się rozpocząć nagrywania. Zamknij inne aplikacje używające mikrofonu i spróbuj ponownie."
