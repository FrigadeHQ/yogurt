    "This was turned off before, so only Settings can turn it on." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This was turned off before, so only Settings can turn it on."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف هذا من قبل، لذا لا يمكن تشغيله إلا من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আগে বন্ধ করা হয়েছিল, তাই শুধু সেটিংস থেকেই চালু করা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle bylo dříve vypnuto, takže to jde zapnout jen v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det blev slået fra tidligere, så det kan kun slås til i Indstillinger."
