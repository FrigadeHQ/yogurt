    "Allow Local Network for Yogurt in Settings to reach your computer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Local Network for Yogurt in Settings to reach your computer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالشبكة المحلية لـYogurt في الإعدادات للوصول إلى الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কম্পিউটারে পৌঁছাতে সেটিংসে Yogurt-এর জন্য লোকাল নেটওয়ার্ক চালু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte Yogurtu v Nastavení místní síť, aby se dostal k počítači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Lokalt netværk for Yogurt i Indstillinger for at nå din computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Lokales Netzwerk für Yogurt in den Einstellungen, um deinen Computer zu erreichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε το Τοπικό δίκτυο για το Yogurt στις Ρυθμίσεις για να φτάνει στον υπολογιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Red local para Yogurt en Ajustes para llegar a tu ordenador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli Paikallisverkko Yogurtille Asetuksissa, jotta se tavoittaa tietokoneesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang Local Network para sa Yogurt sa Settings para maabot ang computer mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Réseau local pour Yogurt dans Réglages pour joindre votre ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפשר רשת מקומית ל-Yogurt בהגדרות כדי להגיע למחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कंप्यूटर तक पहुँचने के लिए सेटिंग्ज़ में Yogurt के लिए स्थानीय नेटवर्क की अनुमति दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
