        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone sẽ hỏi quyền tìm thiết bị trên mạng của bạn. Chạm Cho phép để Yogurt kết nối được với máy tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 会请求查找网络中的设备。请轻点“允许”，Yogurt 才能连接到你的电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 會詢問是否能尋找網路上的裝置。請點一下「允許」，Yogurt 才能連到你的電腦。"
          }
        }
      }
    },
    "Your meetings from %@ are on their way. Tap Record to take notes anywhere." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your meetings from %@ are on their way. Tap Record to take notes anywhere."
