          "stringUnit" : {
            "state" : "translated",
            "value" : "זה כובה בעבר, ולכן אפשר להפעיל את זה רק בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे पहले बंद किया गया था, इसलिए इसे सिर्फ़ सेटिंग्ज़ से चालू किया जा सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt korábban kikapcsolták, így csak a Beállításokban kapcsolható be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini pernah dimatikan, jadi hanya bisa dinyalakan dari Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato disattivato in passato, quindi solo Impostazioni può riattivarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前にオフにされたため、「設定」からのみオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 꺼 두었기 때문에 설정에서만 켤 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini pernah dimatikan, jadi hanya Seting boleh menghidupkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette ble slått av tidligere, så bare Innstillinger kan slå det på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is eerder uitgezet, dus alleen Instellingen kan het weer aanzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zostało wcześniej wyłączone, więc można to włączyć tylko w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
