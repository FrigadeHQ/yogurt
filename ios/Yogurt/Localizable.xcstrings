        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মিটিংয়ের পরে আপনার কম্পিউটার এটি লেখে। দুটি একই Wi-Fi-তে থাকলে এখানে দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
