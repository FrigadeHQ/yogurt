    "See the meetings from Yogurt on your computer here too, and send what you record on your iPhone back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the meetings from Yogurt on your computer here too, and send what you record on your iPhone back."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد هنا أيضًا الاجتماعات من Yogurt على الكمبيوتر، وأرسل إليه ما تسجّله على الـiPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কম্পিউটারের Yogurt-এর মিটিং এখানেও দেখুন, আর iPhone-এ যা রেকর্ড করেন তা ফেরত পাঠান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidět tady i schůzky z Yogurtu na počítači a posílat do něj to, co nahrajete na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se også møderne fra Yogurt på din computer her, og send det, du optager på din iPhone, tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh die Meetings aus Yogurt auf deinem Computer auch hier und schick deine iPhone-Aufnahmen zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε εδώ και τις συσκέψεις από το Yogurt στον υπολογιστή σας, και στείλτε πίσω ό,τι ηχογραφείτε στο iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve aquí también las reuniones de Yogurt en tu ordenador y envíale lo que grabes en tu iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe tietokoneesi Yogurtin kokoukset myös täällä ja lähetä iPhonella tallentamasi takaisin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makita rin dito ang mga meeting mula sa Yogurt sa computer mo, at ibalik doon ang nire-record mo sa iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez ici aussi les réunions de Yogurt sur votre ordinateur, et renvoyez-y ce que vous enregistrez sur votre iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לראות כאן גם את הפגישות מ-Yogurt במחשב, ולשלוח אליו את מה שמוקלט ב-iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कंप्यूटर पर Yogurt की मीटिंग यहाँ भी देखें, और iPhone पर रिकॉर्ड की गई चीज़ें वापस भेजें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lásd itt is a számítógéped Yogurtjának megbeszéléseit, és küldd vissza, amit az iPhone-on veszel fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat juga rapat dari Yogurt di komputer Anda di sini, dan kirim balik rekaman dari iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi qui anche le riunioni di Yogurt sul tuo computer e rimandagli quello che registri sull’iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのYogurtにあるミーティングをここでも見られ、iPhoneで録音したものを送り返せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 Yogurt에 있는 회의를 여기서도 보고, iPhone에서 녹음한 것을 컴퓨터로 보내세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat juga mesyuarat daripada Yogurt pada komputer anda di sini, dan hantar semula apa yang anda rakam pada iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se møtene fra Yogurt på datamaskinen her også, og send det du tar opp på iPhonen tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie de meetings uit Yogurt op je computer ook hier, en stuur terug wat je op je iPhone opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz tu również spotkania z Yogurt na komputerze i wysyłaj do niego nagrania z iPhone’a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja aqui também as reuniões do Yogurt no seu computador e envie de volta o que você gravar no iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedeți aici și întâlnirile din Yogurt de pe computer și trimiteți înapoi ce înregistrați pe iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите здесь встречи из Yogurt на компьютере и отправляйте туда записи с iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mötena från Yogurt på din dator här också, och skicka tillbaka det du spelar in på din iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูการประชุมจาก Yogurt บนคอมพิวเตอร์ที่นี่ด้วย และส่งสิ่งที่อัดบน iPhone กลับไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızdaki Yogurt toplantılarını burada da görün, iPhone’da kaydettiklerinizi geri gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дивіться тут зустрічі з Yogurt на комп’ютері й надсилайте туди записи з iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem cả các cuộc họp từ Yogurt trên máy tính ở đây, và gửi lại những gì bạn ghi trên iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里也能看到电脑上 Yogurt 的会议，并把 iPhone 上的录音发回电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡也能看到電腦上 Yogurt 的會議，並把 iPhone 上的錄音傳回電腦。"
          }
        }
      }
    },
    "Set a passcode on this iPhone to use this." : {
