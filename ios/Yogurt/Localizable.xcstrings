    "Apple Intelligence can't write notes in %@ yet. Your transcript is saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence can't write notes in %@ yet. Your transcript is saved."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Apple Intelligence كتابة الملاحظات بـ%@ بعد. نصك محفوظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence এখনও %@ ভাষায় নোট লিখতে পারে না। আপনার ট্রান্সক্রিপ্ট সেভ করা আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence zatím neumí psát poznámky v jazyce %@. Přepis je uložený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kan ikke skrive noter på %@ endnu. Din transskription er gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kann noch keine Notizen auf %@ schreiben. Dein Transkript ist gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Apple Intelligence δεν γράφει ακόμη σημειώσεις στα %@. Η απομαγνητοφώνηση είναι αποθηκευμένη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún no puede escribir notas en %@. Tu transcripción está guardada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ei vielä osaa kirjoittaa muistiinpanoja kielellä %@. Litterointi on tallessa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa makasulat ang Apple Intelligence ng notes sa %@. Naka-save ang transcript mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ne peut pas encore rédiger de notes en %@. Votre transcription est sauvegardée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence עדיין לא יכול לכתוב סיכום ב%@. התמלול שמור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence अभी %@ में नोट्स नहीं लिख सकता। आपका ट्रांसक्रिप्ट सेव है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple Intelligence még nem tud jegyzetet írni ezen a nyelven: %@. Az átiratod mentve van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence belum bisa menulis catatan dalam %@. Transkrip Anda tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence non sa ancora scrivere note in %@. La trascrizione è salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceはまだ%@でノートを作成できません。文字起こしは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence는 아직 %@로 노트를 쓸 수 없어요. 녹취록은 저장되어 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence belum boleh menulis nota dalam %@. Transkrip anda disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kan ikke skrive notater på %@ ennå. Transkripsjonen er lagret."
          }
