    "1 change hasn't reached your computer yet and will be lost." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 change hasn't reached your computer yet and will be lost."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير واحد لم يصل إلى الكمبيوتر بعد وسيضيع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "১টি পরিবর্তন এখনও আপনার কম্পিউটারে পৌঁছায়নি এবং হারিয়ে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 změna se ještě nedostala do počítače a ztratí se."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ændring har ikke nået din computer endnu og går tabt."
