    "Update Yogurt on your iPhone or computer so they can sync again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Yogurt on your iPhone or computer so they can sync again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث Yogurt على الـiPhone أو الكمبيوتر ليتمكنا من المزامنة مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আবার সিঙ্ক করার জন্য iPhone বা কম্পিউটারে Yogurt আপডেট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizujte Yogurt na iPhonu nebo počítači, aby se znovu mohly synchronizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater Yogurt på din iPhone eller computer, så de kan synkronisere igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Yogurt auf deinem iPhone oder Computer, damit sie wieder synchronisieren können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώστε το Yogurt στο iPhone ή στον υπολογιστή ώστε να συγχρονίζονται ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Yogurt en tu iPhone o en tu ordenador para que puedan volver a sincronizarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä Yogurt iPhonessa tai tietokoneella, jotta ne voivat taas synkronoida."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-update ang Yogurt sa iPhone o computer mo para makapag-sync ulit sila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Yogurt sur votre iPhone ou votre ordinateur pour qu’ils puissent de nouveau se synchroniser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לעדכן את Yogurt ב-iPhone או במחשב כדי שיוכלו לסנכרן שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone या कंप्यूटर पर Yogurt अपडेट करें ताकि वे फिर से सिंक हो सकें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frissítsd a Yogurtot az iPhone-on vagy a számítógépen, hogy újra szinkronizálhassanak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui Yogurt di iPhone atau komputer Anda agar bisa sinkron lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Yogurt sul tuo iPhone o sul computer così possono sincronizzarsi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再び同期できるよう、iPhoneかコンピュータのYogurtをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 동기화하려면 iPhone이나 컴퓨터의 Yogurt를 업데이트하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemas kini Yogurt pada iPhone atau komputer anda supaya ia boleh disegerakkan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdater Yogurt på iPhonen eller datamaskinen så de kan synkronisere igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk Yogurt bij op je iPhone of computer zodat ze weer kunnen synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj Yogurt na iPhonie lub komputerze, aby znowu mogły się synchronizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
