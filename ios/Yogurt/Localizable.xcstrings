    "Pairing isn't open on your computer any more. Click Pair a phone there, then type the new code." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairing isn't open on your computer any more. Click Pair a phone there, then type the new code."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد الإقران مفتوحًا على الكمبيوتر. انقر إقران هاتف هناك، ثم اكتب الرمز الجديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কম্পিউটারে যুক্ত করা আর খোলা নেই। সেখানে ফোন যুক্ত করুন-এ ক্লিক করে নতুন কোড লিখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párování už na počítači není otevřené. Klikněte tam na Spárovat telefon a zadejte nový kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parring er ikke åben på din computer længere. Klik på Par en telefon der, og skriv den nye kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Koppeln ist auf deinem Computer nicht mehr offen. Klick dort auf iPhone koppeln und gib den neuen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύζευξη δεν είναι πια ανοιχτή στον υπολογιστή σας. Κάντε κλικ εκεί στη Σύζευξη τηλεφώνου και πληκτρολογήστε τον νέο κωδικό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vinculación ya no está abierta en tu ordenador. Haz clic allí en Vincular un teléfono y escribe el nuevo código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistäminen ei ole enää auki tietokoneellasi. Klikkaa siellä Yhdistä puhelin ja kirjoita uusi koodi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na bukas ang pagpapares sa computer mo. I-click doon ang Ipares ang isang phone, tapos i-type ang bagong code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’association n’est plus ouverte sur votre ordinateur. Cliquez sur Associer un téléphone, puis saisissez le nouveau code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצימוד כבר לא פתוח במחשב. יש ללחוץ שם על צימוד טלפון ולהקליד את הקוד החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कंप्यूटर पर जोड़ना अब खुला नहीं है। वहाँ फ़ोन जोड़ें पर क्लिक करें, फिर नया कोड लिखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A párosítás már nincs nyitva a számítógépeden. Kattints ott a Telefon párosítása gombra, és írd be az új kódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemasangan sudah tidak terbuka di komputer Anda. Klik Pasangkan ponsel di sana, lalu ketik kode yang baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbinamento non è più aperto sul tuo computer. Fai clic lì su Abbina un telefono, poi inserisci il nuovo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータでペアリングが終了しています。そちらで「iPhoneとペアリング」をクリックして、新しいコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 페어링이 더 이상 열려 있지 않아요. 컴퓨터에서 휴대폰 페어링을 클릭한 뒤 새 코드를 입력해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemasangan tidak lagi dibuka pada komputer anda. Klik Pasangkan telefon di sana, kemudian taip kod baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkobling er ikke åpen på datamaskinen lenger. Klikk på Koble til en telefon der, og skriv inn den nye koden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppelen staat niet meer open op je computer. Klik daar op Telefoon koppelen en typ de nieuwe code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parowanie nie jest już otwarte na komputerze. Kliknij tam Sparuj telefon i wpisz nowy kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pareamento não está mais aberto no seu computador. Clique em Parear um celular lá e digite o novo código."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asocierea nu mai e deschisă pe computer. Dați clic acolo pe Asociază un telefon, apoi introduceți codul nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение на компьютере уже закрыто. Нажмите там «Подключить телефон» и введите новый код."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkopplingen är inte öppen på din dator längre. Klicka på Parkoppla en telefon där och skriv den nya koden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การจับคู่บนคอมพิวเตอร์ปิดไปแล้ว คลิกจับคู่โทรศัพท์ที่นั่น แล้วพิมพ์รหัสใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızda eşleme artık açık değil. Orada Telefon eşle’ye tıklayıp yeni kodu yazın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під’єднання на комп’ютері вже закрито. Натисніть там «Під’єднати телефон» і введіть новий код."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc ghép nối không còn mở trên máy tính. Hãy nhấp Ghép nối điện thoại ở đó, rồi nhập mã mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑上的配对已关闭。请在电脑上点击“配对手机”，然后输入新的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦上的配對已關閉。請在電腦上按一下「配對手機」，然後輸入新的配對碼。"
          }
        }
      }
    },
