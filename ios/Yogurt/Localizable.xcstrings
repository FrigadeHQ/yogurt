    "Draft from this iPhone. Your computer will write the final summary." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draft from this iPhone. Your computer will write the final summary."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسودة من هذا الـiPhone. سيكتب الكمبيوتر الملخص النهائي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPhone-এর খসড়া। চূড়ান্ত সারাংশ আপনার কম্পিউটার লিখবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncept z tohoto iPhonu. Konečný souhrn napíše váš počítač."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kladde fra denne iPhone. Din computer skriver det endelige resumé."
