          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे स्क्रीन टाइम या किसी डिवाइस सेटिंग ने बंद किया है, इसलिए Yogurt इसके लिए नहीं पूछ सकता।"
