    "Go to Settings, then Phone, and click Pair a phone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Settings, then Phone, and click Pair a phone."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى الإعدادات، ثم الهاتف، وانقر إقران هاتف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংসে যান, তারপর ফোন, এবং ফোন যুক্ত করুন-এ ক্লিক করুন।"
          }
        },
        "cs" : {
