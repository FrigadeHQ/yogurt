    "Private AI meeting notes that stay on your iPhone. No bot joins your meetings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private AI meeting notes that stay on your iPhone. No bot joins your meetings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظات اجتماعات خاصة بالذكاء الاصطناعي تبقى على الـiPhone. لا ينضم أي روبوت إلى اجتماعاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যক্তিগত AI মিটিং নোট, যা আপনার iPhone-এই থাকে। কোনো বট আপনার মিটিংয়ে যোগ দেয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromé AI poznámky ze schůzek, které zůstávají ve vašem iPhonu. Do schůzek se nepřipojuje žádný bot."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private AI-mødenoter, der bliver på din iPhone. Ingen bot deltager i dine møder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private KI-Meeting-Notizen, die auf deinem iPhone bleiben. Kein Bot tritt deinen Meetings bei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιδιωτικές σημειώσεις συσκέψεων με AI που μένουν στο iPhone σας. Κανένα bot δεν μπαίνει στις συσκέψεις σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas de reuniones con IA privada que se quedan en tu iPhone. Ningún bot se une a tus reuniones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityiset tekoälyn kokousmuistiinpanot, jotka pysyvät iPhonessasi. Mikään botti ei liity kokouksiisi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pribadong AI meeting notes na nananatili sa iPhone mo. Walang bot na sumasali sa mga meeting mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des notes de réunion par IA, privées, qui restent sur votre iPhone. Aucun bot ne rejoint vos réunions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיכומי פגישות פרטיים עם AI שנשארים ב-iPhone שלך. אף בוט לא מצטרף לפגישות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निजी AI मीटिंग नोट्स जो आपके iPhone पर ही रहते हैं। कोई बॉट आपकी मीटिंग में शामिल नहीं होता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privát AI-megbeszélésjegyzetek, amelyek az iPhone-odon maradnak. Egy bot sem csatlakozik a megbeszéléseidhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
