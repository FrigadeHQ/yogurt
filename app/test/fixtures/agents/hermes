#!/usr/bin/env node
// A stand-in for `hermes acp` in tests: Agent Client Protocol over stdio, no modules (it runs as CommonJS or ESM).
// It asks for a permission once (Yogurt must turn it down), thinks, then answers in pieces. FAKE_AGENT_FAIL=1: it
// stops before answering. YOGURT_FAKE_AGENT_LOG: each prompt and the permission's outcome are appended there.
const send = (m) => process.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...m }) + '\n')
const log = (o) => { if (process.env.YOGURT_FAKE_AGENT_LOG) process.getBuiltinModule('node:fs').appendFileSync(process.env.YOGURT_FAKE_AGENT_LOG, JSON.stringify({ agent: 'hermes', cwd: process.cwd(), ...o }) + '\n') }
const answer = (prompt) => prompt.includes('</question>') ? 'Hermes says: the site goes live on Tuesday.'
  : prompt.includes('Now give this meeting a title') ? 'Launch plan from Hermes'
  : prompt.includes('Suggest one existing folder') ? '{"folder":null,"confidence":0.1}'
  : '## Hermes notes\n- The site goes live on **Tuesday**.\n## Next steps\n- **You:** Share the plan.'
let rest = '', prompted
process.stdin.on('data', (d) => {
  rest += d
  for (let i = rest.indexOf('\n'); i >= 0; i = rest.indexOf('\n')) {
    const line = rest.slice(0, i); rest = rest.slice(i + 1)
    if (!line.trim()) continue
    const m = JSON.parse(line)
    if (m.method === 'initialize') send({ id: m.id, result: { protocolVersion: 1, agentCapabilities: {}, agentInfo: { name: 'hermes-agent', version: 'test' } } })
    else if (m.method === 'session/new') send({ id: m.id, result: { sessionId: 'fake-session' } })
    else if (m.method === 'session/prompt') {
      if (process.env.FAKE_AGENT_FAIL === '1') process.exit(3)
      prompted = { id: m.id, text: m.params.prompt.map((p) => p.text).join('') }
      send({ id: 900, method: 'session/request_permission', params: { sessionId: 'fake-session', toolCall: { title: 'write a file' }, options: [{ optionId: 'allow', kind: 'allow_once' }] } })
    } else if (m.id === 900 && prompted) {
      log({ prompt: prompted.text, permission: m.result?.outcome?.outcome ?? 'error' })
      const update = (sessionUpdate, text) => send({ method: 'session/update', params: { sessionId: 'fake-session', update: { sessionUpdate, content: { type: 'text', text } } } })
      update('agent_thought_chunk', 'Thinking about the meeting. ')
      for (const piece of answer(prompted.text).match(/\S+\s*/g)) update('agent_message_chunk', piece)
      send({ id: prompted.id, result: { stopReason: 'end_turn' } })
      prompted = undefined
    }
  }
})
process.stdin.on('end', () => process.exit(0))
